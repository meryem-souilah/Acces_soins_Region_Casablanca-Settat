@startuml cas_utilisation
!include style.iuml
title Cas d'utilisation — phase 1 : collecte des données
left to right direction

actor "Membre du groupe\n(opérateur)" as Op
actor "Enseignant / jury" as Jury

rectangle "Pipeline de collecte (scripts Python)" {
  usecase "Collecter les 5 sources" as UC1
  usecase "Retélécharger depuis\nles sources (--force)" as UC2
  usecase "Rejouer depuis le cache" as UC3
  usecase "Découper sur la région et\nreprojeter en EPSG:26191" as UC4
  usecase "Documenter la provenance\n(manifeste, README, SOURCES.md)" as UC5
  usecase "Contrôler le jeu de données\n(CRS, emprise, jointure HCP)" as UC6
  usecase "Archiver les sources brutes" as UC7
  usecase "Reconstruire depuis l'archive\n(SHA-256 vérifiés)" as UC8
  usecase "Vérifier visuellement\ndans QGIS" as UC9
  usecase "Consulter la provenance\net le rapport de contrôle" as UC10
}

actor "API Overpass\n(OpenStreetMap)" as OSM <<système>>
actor "Geofabrik" as GF <<système>>
actor "WorldPop" as WP <<système>>
actor "hcp.ma" as HCP <<système>>

Op --> UC1
Op --> UC6
Op --> UC7
Op --> UC8
Op --> UC9
Jury --> UC10
Jury --> UC6

UC2 .> UC1 : <<extend>>
UC3 .> UC1 : <<extend>>
UC1 .> UC4 : <<include>>
UC1 .> UC5 : <<include>>
UC8 .> UC4 : <<include>>

UC1 --> OSM
UC1 --> GF
UC1 --> WP
UC1 --> HCP
@enduml
