# Données brutes de la Phase 1 : on versionne la structure, la provenance et les couches légères (< 2 Mo),
# mais pas l'archive routière Geofabrik lourde (> 100 Mo, limite GitHub).
Phase_1_Acquisition_et_Collecte/donnees_brutes/**
!Phase_1_Acquisition_et_Collecte/donnees_brutes/**/
!Phase_1_Acquisition_et_Collecte/donnees_brutes/README.md
!Phase_1_Acquisition_et_Collecte/donnees_brutes/manifest.json
!Phase_1_Acquisition_et_Collecte/donnees_brutes/osm_sante/requete.overpassql
!Phase_1_Acquisition_et_Collecte/donnees_brutes/osm_sante/etablissements_sante.gpkg
!Phase_1_Acquisition_et_Collecte/donnees_brutes/limites/requete_communes.overpassql
!Phase_1_Acquisition_et_Collecte/donnees_brutes/limites/limites_casablanca_settat.gpkg
!Phase_1_Acquisition_et_Collecte/donnees_brutes/worldpop/worldpop_2020_casablanca_settat_26191.tif
!Phase_1_Acquisition_et_Collecte/donnees_brutes/hcp/tableaux_bruts_region.csv

# Données propres de la Phase 2 : le GeoPackage complet (316 012 tronçons, ~116 Mo) dépasse la
# limite GitHub de 100 Mo. Il se régénère avec scripts/nettoyage.py ; on versionne à la place
# la sauvegarde PostGIS compressée donnees_propres/acces_soins.backup (scripts/import_postgis.py --sauvegarde).
Phase_2_Pretraitement_et_Geodatabase/donnees_propres/base_sante.gpkg
Phase_2_Pretraitement_et_Geodatabase/donnees_propres/*.gpkg-shm
Phase_2_Pretraitement_et_Geodatabase/donnees_propres/*.gpkg-wal

# Caches et présentations (conservées uniquement en local hors du dépôt)
cache/
**/presentation/
sauvegarde_sources/

# Python / Jupyter / OS
__pycache__/
*.pyc
.ipynb_checkpoints/
*.part
desktop.ini
.env
