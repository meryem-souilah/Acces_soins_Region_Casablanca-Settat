ndArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;exitX=0.7;exitY=1;entryX=0;entryY=0.75;fontSize=11;fontColor=#5B6B78;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mld-46" target="mld-55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mld-64" value="niveau_defaut" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B78;strokeWidth=1.25;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;fontColor=#5B6B78;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mld-26" target="mld-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mld-65" value="code_niveau" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B78;strokeWidth=1.25;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;exitX=1;exitY=0.8;entryX=1;entryY=0.5;fontSize=11;fontColor=#5B6B78;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mld-13" target="mld-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mld-66" value="id_noeud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B78;strokeWidth=1.25;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;fontColor=#5B6B78;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mld-39" target="mld-55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mld-67" value="id_noeud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6B78;strokeWidth=1.25;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;exitX=0.15;exitY=1;entryX=1;entryY=0.5;fontSize=11;fontColor=#5B6B78;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mld-13" target="mld-55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mld-68" value="&lt;b&gt;Contraintes implémentées dans schema.sql&lt;/b&gt;&lt;br&gt;• NOT NULL sur toutes les géométries · type et SRID fixés : geometry(Point, 26191), geometry(LineString, 26191), geometry(Polygon/MultiPolygon, 26191)&lt;br&gt;• CHECK (ST_IsValid(geom)) sur province, commune et maille_h3 · CHECK (type_province IN ('province', 'prefecture'))&lt;br&gt;• Index GIST sur les 6 colonnes geom · Index B-tree sur les 10 clés étrangères (province, commune, type, niveau, noeuds)&lt;br&gt;• FK ON UPDATE CASCADE · ON DELETE RESTRICT sur les référentiels/entités administratives · ON DELETE CASCADE sur troncon → noeud · ON DELETE SET NULL sur id_noeud&lt;br&gt;• CHECK (population &amp;gt;= 0), CHECK (pop_2024 &amp;gt;= 0), CHECK (longueur_m &amp;gt; 0), CHECK (vitesse_kmh &amp;gt; 0), CHECK (noeud_depart &amp;lt;&amp;gt; noeud_arrivee), CHECK (resolution BETWEEN 0 AND 15)&lt;br&gt;• CHECK (niveau_source IN ('defaut_type', 'relecture')), CHECK (secteur IN ('public', 'prive')), CHECK (nb_lits &amp;gt;= 0), CHECK (seuil_acces_min &amp;gt; 0 et source_norme renseignée)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2D3A;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1360" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>