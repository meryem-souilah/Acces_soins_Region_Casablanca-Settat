xPoint as="offset"/></mxGeometry></mxCell><mxCell id="mcd-93" style="endArrow=none;html=1;strokeColor=#5B6B78;strokeWidth=1.25;" edge="1" parent="1" source="mcd-45" target="mcd-56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mcd-94" value="(0,n)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;fontColor=#1A6F67;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="mcd-93"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="mcd-95" style="endArrow=none;html=1;strokeColor=#5B6B78;strokeWidth=1.25;" edge="1" parent="1" source="mcd-38" target="mcd-57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mcd-96" value="(1,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;fontColor=#1A6F67;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="mcd-95"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="mcd-97" style="endArrow=none;html=1;strokeColor=#5B6B78;strokeWidth=1.25;" edge="1" parent="1" source="mcd-45" target="mcd-57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mcd-98" value="(0,n)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;fontColor=#1A6F67;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="mcd-97"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="mcd-99" style="endArrow=none;html=1;strokeColor=#5B6B78;strokeWidth=1.25;" edge="1" parent="1" source="mcd-38" target="mcd-58"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mcd-100" value="(1,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;fontColor=#1A6F67;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="mcd-99"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="mcd-101" style="endArrow=none;html=1;strokeColor=#5B6B78;strokeWidth=1.25;" edge="1" parent="1" source="mcd-45" target="mcd-58"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mcd-102" value="(0,n)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;fontColor=#1A6F67;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="mcd-101"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="mcd-103" value="&lt;b&gt;Choix de conception&lt;/b&gt;&lt;br&gt;• RATTACHER : un hexagone H3 est rattaché à la commune qui contient son &lt;b&gt;centre&lt;/b&gt; (1,1). Alternative plus exacte mais plus lourde : association (n,n) porteuse de part_surface.&lt;br&gt;• ACCROCHER et RACCORDER : chaque établissement et le centre de chaque hexagone sont raccordés au &lt;b&gt;nœud routier le plus proche&lt;/b&gt;. Le réseau relie ainsi la demande (hexagones) à l'offre (établissements) : c'est ce qui permet de calculer un temps de trajet.&lt;br&gt;• LOCALISER, RATTACHER, ACCROCHER et RACCORDER sont des relations &lt;b&gt;spatiales&lt;/b&gt; matérialisées en clés étrangères : plus rapides à interroger, et leur cohérence géométrique devient un contrôle qualité.&lt;br&gt;• NIVEAU_SOIN porte les &lt;b&gt;paramètres de l'analyse&lt;/b&gt; (seuil d'accès, population cible, source de la norme) : la question est « où ajouter &lt;b&gt;quel type&lt;/b&gt; d'offre ».&lt;br&gt;• Le niveau est une propriété de l'&lt;b&gt;établissement&lt;/b&gt; (ASSURER), pas de son type : un hôpital provincial et un CHU sont tous deux « hospital » dans OSM. Le type ne fait que PROPOSER_PAR_DEFAUT un niveau, corrigé après relecture (niveau_source).&lt;br&gt;• &lt;b&gt;Couverture stricte&lt;/b&gt; : un établissement ne couvre que son propre niveau (un CHU ne couvre pas le niveau 1). Règle portée par la donnée : couvre_niveaux_inferieurs = false, passée à true dans un scénario de comparaison.&lt;br&gt;• ACCEDER (pointillés) sera le résultat du calcul d'accès en séance 5, calculé &lt;b&gt;par niveau de soin&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1F2D3A;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="400" height="560" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="mld" name="MLD — PostGIS (EPSG:26191)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mld-1" value="&lt;b style='font-size:18px'&gt;MLD — schéma PostGIS, toutes géométries en EPSG:26191&lt;/b&gt;&lt;br&gt;PK = clé primaire · FK = clé étrangère · une association (1,1)–(x,n) devient une FK côté (1,1) · ACCEDER (n,n) deviendra une table en séance 5 (h3_index, code_niveau, temps_min)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1F2D3A;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="56" as="geometry"/></mxCell><mxCell id="mld-2" value="province" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#44515C;strokeColor=#44515C;fontColor=#FFFFFF;swimlaneFillColor=#F1F3F5;rounded=1;arcSize=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="270" height="122" as="geometry"/></mxCell><mxCell id="mld-3" value="🔑 code_province : varchar(10)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;html=1;fontSize=12;fontColor=#1F2D3A;" vertex="1" parent="mld-2"><mxGeometry y="28" width="270" height="22" as="geometry"/><