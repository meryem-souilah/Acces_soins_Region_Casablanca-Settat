        </mxCell>
        <mxCell id="mcd-102" connectable="0" parent="mcd-101" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;fontColor=#1A6F67;labelBackgroundColor=#FFFFFF;" value="(0,n)" vertex="1">
