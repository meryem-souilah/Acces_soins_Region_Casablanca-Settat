@startuml sequence_collecte
!include style.iuml
title Séquence — run_collecte.bat (collecte complète puis contrôle)
autonumber

actor "Opérateur" as Op
participant "run_collecte.bat" as Bat
participant "collecte.py" as Col
participant "config.py" as Cfg
participant "API Overpass" as Ovp
participant "Geofabrik" as Gf
participant "WorldPop" as Wp
participant "hcp.ma" as Hcp
database "donnees_brutes/" as DB
participant "controle_collecte.py" as Ctl

Op -> Bat : lancer
Bat -> Bat : activer l'environnement conda
Bat -> Col : python scripts\\collecte.py
Col -> Cfg : import (URL, CRS, filtres,\ncorrectif PROJ)

group Étape 1 — limites
  Col -> Ovp : requête communes admin_level=8,\ncode HCP 06.*
  Ovp --> Col : 153 relations (JSON)
  Col -> DB : limites_casablanca_settat.gpkg\n(region, communes)
end
group Étape 2 — sante
  Col -> DB : lire le contour régional
  Col -> Ovp : requête amenity / healthcare
  Ovp --> Col : 1 734 éléments
  Col -> DB : etablissements_sante.gpkg (1 588)
end
group Étape 3 — routes
  alt extrait absent
    Col -> Gf : télécharger morocco-latest-free.shp.zip
    Gf --> Col : extrait OSM (~ 490 Mo)
  end
  Col -> DB : routes_casablanca_settat.gpkg (130 813 tronçons)
end
group Étape 4 — worldpop
  alt raster absent
    Col -> Wp : télécharger mar_ppp_2020_constrained.tif
    Wp --> Col : raster national
  end
  Col -> DB : rasters régionaux 4326 et 26191
end
group Étape 5 — hcp
  Col -> Hcp : télécharger le PDF des tableaux
  Hcp --> Col : PDF (138 pages)
  Col -> DB : tableaux_bruts_region.csv (255 lignes)
end
Col -> DB : manifest.json, README.md, SOURCES.md
Col --> Bat : code de sortie (0 si 5/5 OK)

Bat -> Ctl : python scripts\\controle_collecte.py
Ctl -> DB : lire les couches produites
Ctl -> Ctl : CRS, géométries, hors région,\njointure 153/153
Ctl -> DB : preuves/controle_collecte.md,\ncarte_controle.png
Ctl --> Op : rapport + code de sortie
@enduml
