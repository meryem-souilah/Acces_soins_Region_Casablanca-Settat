@startuml activite_collecte
!include style.iuml
title Activité — exécution de collecte.py puis de controle_collecte.py

start
:Lire les options de la ligne de commande\n(étapes, force, routes, archiver, depuis-archive);
if (--archiver ?) then (oui)
  :Zipper les fichiers bruts + manifeste\n→ sauvegarde_sources/sources_brutes_AAAA-MM-JJ.zip;
  stop
endif
if (--depuis-archive ?) then (oui)
  :Restaurer les fichiers bruts;
  if (SHA-256 identiques au manifeste ?) then (non)
    :Arrêt : archive altérée;
    stop
  endif
endif

partition "Pour chaque étape, dans l'ordre limites → sante → routes → worldpop → hcp" {
  repeat
    if (Fichier brut en cache et pas --force ?) then (oui)
      :Réutiliser le fichier local;
    else (non)
      :Télécharger depuis la source\n(serveurs et miroirs essayés tour à tour);
    endif
    if (Source disponible ?) then (oui)
      :Découper sur le contour régional;
      :Reprojeter en EPSG:26191;
      :Écrire la couche produite\n(GeoPackage, GeoTIFF ou CSV);
      :Statut OK + provenance\n(URL, dates, CRS, SHA-256, volumes);
    else (non)
      if (Étape limites ?) then (oui)
        :Secours : contour geoBoundaries\n(sans communes);
      else (non)
        :Statut ÉCHEC + message\n(les autres étapes continuent);
      endif
    endif
    :Réécrire manifest.json,\nREADME de provenance, SOURCES.md;
  repeat while (Étape suivante ?) is (oui)
  -> non;
}

partition "controle_collecte.py" {
  :Vérifier chaque couche :\nCRS = EPSG:26191, géométries valides,\nentités dans la région;
  :Vérifier le raster : écart de population < 1 %;
  :Apparier communes et tableau HCP\npar code géographique;
  :Écrire preuves/controle_collecte.md\net preuves/carte_controle.png;
}
if (Tout conforme ?) then (oui)
  :Code de sortie 0;
else (non)
  :Code de sortie 1;
endif
stop
@enduml
